{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-caveman",
  "version": "1.0.0",
  "description": "OpenCode plugin: 5 caveman skills and 5 commands with auto-invoke on session start",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "skill-loader.ts",
    "command-loader.ts",
    "options-validator.ts",
    "storage-keys.ts",
    "skills/",
    "commands/"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "caveman",
    "skills",
    "commands"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.0.12",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.32"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
